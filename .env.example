# Provider credentials. Only the providers you enable need keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Local inference
OLLAMA_HOST=http://127.0.0.1:11434

# Optional LiteLLM fabric. When set, cloud completions go through the proxy.
# AetherGraph still classifies, plans, and binds models.
LITELLM_BASE_URL=
LITELLM_API_KEY=
AETHERGRAPH_FABRIC=auto
AETHERGRAPH_LITELLM_INCLUDE_LOCAL=false

# Runtime
AETHERGRAPH_CONFIG_DIR=configs
AETHERGRAPH_HOST=0.0.0.0
AETHERGRAPH_PORT=8080
AETHERGRAPH_PUBLIC_URL=http://127.0.0.1:8080
AETHERGRAPH_MODE=inprocess
AETHERGRAPH_POLICY=balanced
AETHERGRAPH_LOG_LEVEL=INFO
